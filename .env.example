# 部署/迁移脚本配置模板：复制为 .env（已 gitignore，不入库）后填写真实值。
# 也可直接 export 同名环境变量（环境变量优先于 .env）。

# Cloudflare API Token（需 D1 Edit + R2 Edit + Pages Edit 权限）
CLOUDFLARE_API_TOKEN=

# Cloudflare 账号 ID
CLOUDFLARE_ACCOUNT_ID=

# 共享 dev 库的 D1 数据库 ID
D1_DATABASE_ID=

# R2 桶名（可选，默认 gitmind）
R2_BUCKET=gitmind

# wrangler 入口（可选）：
# - 指向 wrangler.js 时用当前 node 执行，如 C:/Users/you/AppData/Roaming/npm/node_modules/wrangler/bin/wrangler.js
# - 指向可执行文件时直接执行
# - 留空则使用 PATH 上的 wrangler（npx / wrangler.cmd 均可）
WRANGLER_BIN=
